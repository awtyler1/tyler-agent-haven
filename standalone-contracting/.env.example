# Supabase project that hosts the two edge functions.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Google Places API key for address autocomplete (optional — fields still work
# as plain text without it).
VITE_GOOGLE_PLACES_API_KEY=your-google-places-key
